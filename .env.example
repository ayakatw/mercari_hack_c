# ─────────────────────────────────────────────────────────────
# コピーして使う: cp .env.example .env
# .env は .gitignore 済み。実キーをこのファイルへ書き写さないこと。
# ─────────────────────────────────────────────────────────────

# Gemini API キー（サーバ側でのみ使用。ブラウザへは一切渡らない）
# 取得: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# server.js の待ち受けポート（省略時 3000）
PORT=3000

# 画像解析に使うモデル（省略時 gemini-3.5-flash-lite）
# Gemini 側が空いていれば gemini-3.6-flash の方が結果は良いが、
# 混雑時は数十秒かかることがある。
# GEMINI_MODEL=gemini-3.6-flash
