# コピーして使う: cp .env.example .env
# mise がこのファイルを読み込む（mise activate 済みのシェルが前提）。

# --- server ---
# docker compose の postgres に接続する。値はそのままで動く。
DATABASE_URL=postgres://oshikatsu:oshikatsu@localhost:5432/oshikatsu
PORT=3000

# --- app (Expo) ---
# 未設定なら Expo の dev server ホスト名から自動導出する（実機でもそのまま動く）。
# 自動導出が効かない環境でだけ、PC の LAN IP を明示する。
#   macOS: ipconfig getifaddr en0
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
