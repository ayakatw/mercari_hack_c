{
  "name": "oshikatsu",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r --no-bail typecheck",
    "test": "pnpm --filter server test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && pnpm db:up && pnpm db:push && pnpm seed",
    "db:push": "pnpm --filter server db:push",
    "seed": "pnpm --filter server seed",
    "dev:server": "pnpm --filter server dev",
    "dev:app": "pnpm --filter app start"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11"
  }
}
